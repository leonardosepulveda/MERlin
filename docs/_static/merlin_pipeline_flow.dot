digraph merlin_pipeline_flow {
  rankdir=TB;
  fontname="Helvetica";
  labelloc="t";
  fontsize=16;
  label="MERlin default analysis pipeline (test/auxiliary_files/test_analysis_parameters.json)";
  nodesep=0.35;
  ranksep=0.55;
  node [fontname="Helvetica", shape=box, style="filled,rounded", fontsize=11, margin="0.15,0.08"];
  edge [fontname="Helvetica", fontsize=9, color="#777777", arrowsize=0.7];

  // -- shared root tasks (feed most of the columns below) --
  FiducialCorrelationWarp [label="FiducialCorrelationWarp\n(warp)", fillcolor="#aec6e8", group="root"];
  SimpleGlobalAlignment   [label="SimpleGlobalAlignment\n(globalalign)", fillcolor="#aec6e8", group="root2"];
  {rank=same; FiducialCorrelationWarp; SimpleGlobalAlignment;}

  // -- decoding column --
  DeconvolutionPreprocess [label="DeconvolutionPreprocess\n(preprocess)", fillcolor="#a9d8a9", group="decode"];
  Optimize1 [label="OptimizeIteration\n(Optimize1)", fillcolor="#a9d8a9", group="decode"];
  Optimize2 [label="OptimizeIteration\n(Optimize2)", fillcolor="#a9d8a9", group="decode"];
  Decode [label="Decode\n(decode)", fillcolor="#a9d8a9", group="decode"];

  // -- barcode filtering (two alternative strategies, hang off Decode) --
  FilterBarcodes [label="FilterBarcodes\n(filterbarcodes)", fillcolor="#f0cf8e", group="filter_fixed"];
  ExportBarcodes [label="ExportBarcodes\n(exportbarcodes)", fillcolor="#c9c9c9", group="filter_fixed"];
  GenerateAdaptiveThreshold [label="GenerateAdaptiveThreshold\n(filterbarcodes)", fillcolor="#f0cf8e", group="filter_adaptive"];
  AdaptiveFilterBarcodes [label="AdaptiveFilterBarcodes\n(filterbarcodes)", fillcolor="#f0cf8e", group="filter_adaptive"];

  // -- segmentation column --
  WatershedSegment [label="WatershedSegment\n(segment)", fillcolor="#d3a3ca", group="segment"];
  CleanCellBoundaries [label="CleanCellBoundaries\n(segment)", fillcolor="#d3a3ca", group="segment"];
  CombineCleanedBoundaries [label="CombineCleanedBoundaries\n(segment)", fillcolor="#d3a3ca", group="segment"];
  RefineCellDatabases [label="RefineCellDatabases\n(segment)", fillcolor="#d3a3ca", group="segment"];
  ExportCellMetadata [label="ExportCellMetadata\n(segment)", fillcolor="#d3a3ca", group="segment_export"];

  // -- partitioning (converges filtering + segmentation) --
  PartitionBarcodes [label="PartitionBarcodes\n(partition)", fillcolor="#8fc2c9", group="partition"];
  ExportPartitionedBarcodes [label="ExportPartitionedBarcodes\n(partition)", fillcolor="#8fc2c9", group="partition"];

  // -- sequential signal (off segmentation) --
  SumSignal [label="SumSignal\n(sequential)", fillcolor="#d69a9a", group="sequential"];
  ExportSumSignals [label="ExportSumSignals\n(sequential)", fillcolor="#d69a9a", group="sequential"];

  // -- mosaic (independent side column) --
  CreateFfc [label="CreateFfc\n(createffc)", fillcolor="#e0c9a6", group="mosaic"];
  GenerateMosaicTile [label="GenerateMosaicTile\n(generatemosaic)", fillcolor="#e0c9a6", group="mosaic"];
  CombineMosaicTiles [label="CombineMosaicTiles\n(generatemosaic)", fillcolor="#e0c9a6", group="mosaic"];

  // -- column order, left to right: mosaic | decoding | filtering | segmentation | partition | sequential --
  FiducialCorrelationWarp -> CreateFfc [style=invis];
  CreateFfc -> DeconvolutionPreprocess [style=invis];
  DeconvolutionPreprocess -> FilterBarcodes [style=invis];
  FilterBarcodes -> GenerateAdaptiveThreshold [style=invis];
  GenerateAdaptiveThreshold -> WatershedSegment [style=invis];
  WatershedSegment -> PartitionBarcodes [style=invis];
  PartitionBarcodes -> SumSignal [style=invis];

  // -- alignment / decode --
  FiducialCorrelationWarp -> DeconvolutionPreprocess;
  FiducialCorrelationWarp -> Optimize1;
  DeconvolutionPreprocess -> Optimize1;
  FiducialCorrelationWarp -> Optimize2;
  DeconvolutionPreprocess -> Optimize2;
  Optimize1 -> Optimize2 [label="previous_iteration"];
  DeconvolutionPreprocess -> Decode;
  Optimize2 -> Decode [label="optimize_task"];
  SimpleGlobalAlignment -> Decode;

  // -- filtering --
  Decode -> FilterBarcodes;
  Decode -> GenerateAdaptiveThreshold [label="run_after_task"];
  Decode -> AdaptiveFilterBarcodes;
  GenerateAdaptiveThreshold -> AdaptiveFilterBarcodes [label="adaptive_task"];
  FilterBarcodes -> ExportBarcodes;

  // -- segmentation --
  FiducialCorrelationWarp -> WatershedSegment;
  SimpleGlobalAlignment -> WatershedSegment;
  WatershedSegment -> CleanCellBoundaries;
  SimpleGlobalAlignment -> CleanCellBoundaries;
  CleanCellBoundaries -> CombineCleanedBoundaries;
  WatershedSegment -> RefineCellDatabases;
  CombineCleanedBoundaries -> RefineCellDatabases [label="combine_cleaning_task"];
  RefineCellDatabases -> ExportCellMetadata;

  // -- partitioning --
  AdaptiveFilterBarcodes -> PartitionBarcodes [label="filter_task"];
  RefineCellDatabases -> PartitionBarcodes [label="assignment_task"];
  SimpleGlobalAlignment -> PartitionBarcodes;
  PartitionBarcodes -> ExportPartitionedBarcodes;

  // -- sequential signal --
  FiducialCorrelationWarp -> SumSignal;
  SimpleGlobalAlignment -> SumSignal;
  RefineCellDatabases -> SumSignal [label="segment_task"];
  SumSignal -> ExportSumSignals;

  // -- mosaic --
  SimpleGlobalAlignment -> GenerateMosaicTile;
  FiducialCorrelationWarp -> GenerateMosaicTile;
  DeconvolutionPreprocess -> GenerateMosaicTile;
  CreateFfc -> GenerateMosaicTile [label="ffc_task"];
  GenerateMosaicTile -> CombineMosaicTiles [label="tile_task"];

  // -- legend: one compact HTML-table node, so it can't be stretched
  // across the diagram's full rank range the way a chain of separate
  // legend nodes would be --
  legend [shape=plaintext, fontsize=10, label=<
    <TABLE BORDER="1" COLOR="#dddddd" CELLBORDER="0" CELLSPACING="3" CELLPADDING="2">
      <TR><TD COLSPAN="2"><B>Legend</B></TD></TR>
      <TR><TD BGCOLOR="#aec6e8" WIDTH="18"></TD><TD ALIGN="LEFT">alignment</TD></TR>
      <TR><TD BGCOLOR="#a9d8a9"></TD><TD ALIGN="LEFT">preprocessing / decoding</TD></TR>
      <TR><TD BGCOLOR="#e0c9a6"></TD><TD ALIGN="LEFT">mosaic (FFC + tiling)</TD></TR>
      <TR><TD BGCOLOR="#f0cf8e"></TD><TD ALIGN="LEFT">barcode filtering</TD></TR>
      <TR><TD BGCOLOR="#d3a3ca"></TD><TD ALIGN="LEFT">cell segmentation</TD></TR>
      <TR><TD BGCOLOR="#8fc2c9"></TD><TD ALIGN="LEFT">cell x barcode partitioning</TD></TR>
      <TR><TD BGCOLOR="#d69a9a"></TD><TD ALIGN="LEFT">sequential signal</TD></TR>
      <TR><TD BGCOLOR="#c9c9c9"></TD><TD ALIGN="LEFT">export</TD></TR>
      <TR><TD COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="8">solid arrow = snakemake task dependency (get_dependencies())</FONT></TD></TR>
    </TABLE>
  >];
}
